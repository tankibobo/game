# --- Character voices --------------------------------------------------------
# Provider:
#   claude-code  (default) Claude through YOUR CLAUDE SUBSCRIPTION (Pro/Max/Team).
#                No API key. Sign in once with Claude Code: run `claude`, type
#                /login, choose your Claude account. Replies count against your
#                plan's usage limits. Intended for personal, local play.
#   anthropic    Claude API, billed per token; needs ANTHROPIC_API_KEY.
#   none         Deterministic rule-based characters, no network.
LLM_PROVIDER=claude-code

# Model for the subscription provider: an alias (opus, sonnet, haiku) or a full
# model ID. Leave empty to use your account's default model.
CLAUDE_MODEL=
# Reasoning effort: low | medium | high (character turns are short; low is snappy)
CLAUDE_EFFORT=low
# Optional path to your own `claude` executable (default: the one bundled with
# the Claude Agent SDK, which shares your ~/.claude login)
CLAUDE_CODE_PATH=

# Per-call timeout in ms (default 120000 for claude-code, 60000 for anthropic)
LLM_TIMEOUT_MS=

# --- Only for LLM_PROVIDER=anthropic -----------------------------------------
# Never used by the subscription provider (it is removed from the child process
# so it cannot override your subscription login).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low
ANTHROPIC_FALLBACKS=on

# --- Server ------------------------------------------------------------------
PORT=8787
# Directory containing save files (SQLite databases)
DATA_DIR=./data
